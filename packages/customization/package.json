{
  "name": "@mercatus-liber/customization",
  "version": "0.1.0",
  "description": "Made-to-order product customization: a shared color palette, finish tiers, per-part color rules, availability status, and an admin-defined pricing engine. No rendering code.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mercatus-liber/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
