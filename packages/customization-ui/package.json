{
  "name": "@mercatus-liber/customization-ui",
  "version": "0.1.0",
  "description": "Default customizer UI as a framework-agnostic Web Component. Rendering only: no persistence or network calls. Currently holds its own copy of the color-resolution logic.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "jsdom": "^30.0.1"
  }
}
