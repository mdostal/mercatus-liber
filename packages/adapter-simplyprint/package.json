{
  "name": "@mercatus-liber/adapter-simplyprint",
  "version": "0.1.0",
  "description": "FulfillmentAdapter for a store that prints in-house: puts a paid order line into the SimplyPrint print queue of the store's own printer farm, and reports when the print is done. It ships nothing.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mercatus-liber/fulfillment": "workspace:*"
  },
  "devDependencies": {
    "@mercatus-liber/core": "workspace:*",
    "@types/node": "^22.7.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
